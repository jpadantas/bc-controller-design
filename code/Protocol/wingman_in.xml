<?xml version="1.0"?>
<!-- Controls written by the wingman policy bridge (fg_bridge.py), one CSV line per packet. -->
<PropertyList>
  <generic>
    <input>
      <line_separator>newline</line_separator>
      <var_separator>,</var_separator>
      <chunk><name>aileron</name><type>double</type><node>/controls/flight/aileron</node></chunk>
      <chunk><name>elevator</name><type>double</type><node>/controls/flight/elevator</node></chunk>
      <chunk><name>rudder</name><type>double</type><node>/controls/flight/rudder</node></chunk>
      <chunk><name>throttle</name><type>double</type><node>/controls/engines/engine[0]/throttle</node></chunk>
      <chunk><name>aileron_trim</name><type>double</type><node>/controls/flight/aileron-trim</node></chunk>
      <chunk><name>elevator_trim</name><type>double</type><node>/controls/flight/elevator-trim</node></chunk>
    </input>
  </generic>
</PropertyList>
